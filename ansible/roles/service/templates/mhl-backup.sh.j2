#!/usr/bin/env bash
# {{ ansible_managed }} — snapshot backup for service "{{ item.key }}" on {{ inventory_hostname }}
# Copies the declared paths into {{ service_backup_root }}/{{ inventory_hostname }}/{{ item.key }}/<UTC stamp>/,
# writes SHA256SUMS, updates `latest`, keeps the newest {{ item.value.backup.keep | default(14) }}.
set -euo pipefail
ROOT="{{ service_backup_root }}/{{ inventory_hostname }}/{{ item.key }}"
mountpoint -q "{{ service_backup_root | dirname }}" || { echo "backup root not mounted; skipping"; exit 0; }
STAMP=$(date -u +%Y-%m-%dT%H%M%SZ); DEST="$ROOT/$STAMP"
mkdir -p "$DEST"
{% for p in item.value.backup.paths %}
cp -a "{{ p }}" "$DEST/"
{% endfor %}
( cd "$DEST" && find . -type f -print0 | sort -z | xargs -0 sha256sum > SHA256SUMS )
ln -sfn "$STAMP" "$ROOT/latest"
ls -1d "$ROOT"/????-??-??T??????Z 2>/dev/null | sort | head -n -{{ item.value.backup.keep | default(14) }} | xargs -r rm -rf
echo "backup {{ item.key }}: $DEST ($(du -sh "$DEST" | cut -f1))"
