#!/usr/bin/env bash
# Install governance from a checked-out McHomeLab into the live locations:
#   ~/.mhl/hooks/*.sh              <- .claude/hooks/*.sh   (Claude Code hooks; settings point here)
#   ~/.mhl/hooks/MANIFEST.sha256   <- scripts/mhl-manifest gen (integrity of the live set)
#   core.hooksPath (both repos)    -> scripts/git-hooks     (git pre-push guard)
# Run from MAIN after a governance PR merges. Target state: ~/.mhl/hooks is
# root-owned and this runs as `sudo scripts/mhl-install-hooks` — then the
# installed copies and the manifest cannot be written by the agent's uid and
# the manifest is integrity VERIFICATION; unprivileged it is a TRIPWIRE and
# says so. Branch edits to .claude/hooks change nothing until installed.
set -euo pipefail
ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
# When run under sudo, install for the invoking user, not root's HOME.
TARGET_HOME="${SUDO_USER:+$(getent passwd "$SUDO_USER" | cut -d: -f6)}"; TARGET_HOME="${TARGET_HOME:-$HOME}"
HOOKS="$TARGET_HOME/.mhl/hooks"
BR=$(git -C "$ROOT" branch --show-current 2>/dev/null || echo "?")
[ "$BR" = "main" ] || [ "${MHL_INSTALL_FROM_BRANCH:-}" = "1" ] || { echo "mhl-install-hooks: refusing to install from branch '$BR' (set MHL_INSTALL_FROM_BRANCH=1 to override for testing)" >&2; exit 1; }
if [ "$(id -u)" -eq 0 ]; then
  install -d -m 755 -o root -g root "$HOOKS"
  for f in "$ROOT"/.claude/hooks/*.sh; do install -m 644 -o root -g root "$f" "$HOOKS/$(basename "$f")"; done
else
  if [ -d "$HOOKS" ] && [ "$(stat -c %u "$HOOKS")" = "0" ]; then echo "mhl-install-hooks: $HOOKS is root-owned — run: sudo $0" >&2; exit 1; fi
  install -d -m 700 "$HOOKS"
  for f in "$ROOT"/.claude/hooks/*.sh; do install -m 700 "$f" "$HOOKS/$(basename "$f")"; done
fi
echo "hooks: installed $(ls "$ROOT"/.claude/hooks/*.sh | wc -l) scripts to $HOOKS (from $BR @ $(git -C "$ROOT" rev-parse --short HEAD))"
MHL_HOOKS_DIR="$HOOKS" HOME="$TARGET_HOME" "$ROOT/scripts/mhl-manifest" gen
[ "$(id -u)" -eq 0 ] && chown root:root "$HOOKS/MANIFEST.sha256" && chmod 644 "$HOOKS/MANIFEST.sha256"
for repo in "$ROOT" "$ROOT/../McHomeLab-Inventory"; do
  git -C "$repo" rev-parse --git-dir >/dev/null 2>&1 || continue   # works for worktrees too
  if [ "$(id -u)" -eq 0 ] && [ -n "${SUDO_USER:-}" ]; then sudo -u "$SUDO_USER" git -C "$repo" config core.hooksPath "$ROOT/scripts/git-hooks"; else git -C "$repo" config core.hooksPath "$ROOT/scripts/git-hooks"; fi
  echo "git:   $(basename "$(cd "$repo" && pwd)") core.hooksPath -> $ROOT/scripts/git-hooks"
done
echo "mode:  $(MHL_HOOKS_DIR="$HOOKS" "$ROOT/scripts/mhl-manifest" mode)"
