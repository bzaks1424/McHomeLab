#!/usr/bin/env bash
# No-plaintext-secrets check for both repos. Two passes (research/RESEARCH_SECRETS_RA.md §6.5):
#   A. name-shaped: a key ENDING in a secret word must have a !vault or {{ }} value
#   B. value-shaped: WireGuard keys, GitHub PATs, Plex claims, PEM private keys
# Usage: mhl-no-secrets [dir ...]   (default: this repo + ../McHomeLab-Inventory)
set -uo pipefail
HERE=$(cd "$(dirname "$0")/.." && pwd)
DIRS=("$@"); [ ${#DIRS[@]} -eq 0 ] && DIRS=("$HERE" "$HERE/../McHomeLab-Inventory")
NAME_RE='^[ \t-]*(?:[A-Za-z0-9._]*_)?(?i:pass|password|passwd|secret|token|api_?key|apikey|claim|private_key|preshared_key|credential)[ \t]*:[ \t]*(?!(!vault|\{\{|"\{\{|'"'"'\{\{|$|#))\S'
SHAPE_RE='(?<![A-Za-z0-9+/])[A-Za-z0-9+/]{43}=(?![A-Za-z0-9+/=])|gh[pousr]_[A-Za-z0-9]{36,}|claim-[A-Za-z0-9_-]{15,}|-----BEGIN [A-Z ]*PRIVATE KEY-----'
EXCL=(--exclude-dir=.git --exclude-dir=.venv --exclude-dir=collections --exclude-dir=archive --exclude-dir=research --exclude-dir=.ansible)
rc=0
for d in "${DIRS[@]}"; do
  [ -d "$d" ] || continue
  pv=$(find "$d" -name '*.pre-vault' -not -path '*/.git/*' 2>/dev/null); [ -n "$pv" ] && { echo "FAIL: plaintext pre-vault backup inside the tree (belongs in ~/.mhl/pre-vault):"; echo "$pv"; rc=1; }
done
for d in "${DIRS[@]}"; do
  [ -d "$d" ] || continue
  # Output is REDACTED to file:line:key — never echo the value into a terminal or CI log.
  hits=$(grep -rnP "${EXCL[@]}" --include='*.yml' --include='*.yaml' --include='*.pre-vault' "$NAME_RE" "$d" 2>/dev/null \
         | grep -v 'inventory/test.yml' | grep -v 'no-secret:' | sed -E 's/^([^:]+:[0-9]+:[[:space:]-]*[^:]+):.*/\1: <redacted>/' || true)
  [ -n "$hits" ] && { echo "FAIL: name-shaped plaintext secret value(s):"; echo "$hits"; rc=1; }
  hits=$(grep -rnP "${EXCL[@]}" --exclude='mhl-no-secrets' --exclude='test-key' "$SHAPE_RE" "$d" 2>/dev/null \
         | grep -v 'no-secret:' | cut -d: -f1,2 | sed 's/$/: <redacted value-shaped secret>/' || true)
  [ -n "$hits" ] && { echo "FAIL: value-shaped secret(s):"; echo "$hits"; rc=1; }
done
[ $rc -eq 0 ] && echo "no-secrets: PASS"
exit $rc
