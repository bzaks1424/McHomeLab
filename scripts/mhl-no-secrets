#!/usr/bin/env bash
# No-plaintext-secrets check for both repos (research/RESEARCH_SECRETS_RA.md §6.5).
#   A. name-shaped: for parseable YAML, the node model in scripts/mhl_secrets.py
#      (shared with mhl-vault-file, so gate and tool cannot disagree); for files
#      that do not parse, the line regex LINE_RE from the same module.
#   B. value-shaped: WireGuard keys, GitHub PATs, Plex claims, PEM private keys.
#   C. no *.pre-vault plaintext backup anywhere in a tree.
# Output is REDACTED to file:line:key[:class] — values are never printed.
# Fails CLOSED: if the venv python or the module is missing, unreadable or
# broken, pass A exits 2 and the gate FAILS with a message. There is no
# fallback to a weaker check.
# Usage: mhl-no-secrets [dir ...]   (default: this repo + ../McHomeLab-Inventory)
#        mhl-no-secrets --range <git-range> [repo]   scan every blob touched in the range
set -uo pipefail
HERE=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)   # symlink-safe
# --range <git-range>: scan every BLOB TOUCHED IN THE RANGE, not the working tree.
# Why this mode exists: the directory scan excludes .git, so it only ever sees the tip.
# A secret committed and then removed in a later commit on the same branch is invisible
# to it and still gets published on push. This materialises every version of every file
# the range touched into a temp tree and reuses the SAME two passes on it -- no second
# implementation of the detection, because two implementations drift (INBOX-073).
RANGE=""
if [ "${1:-}" = "--range" ]; then
  [ $# -ge 2 ] || { echo "usage: mhl-no-secrets --range <git-range> [dir]"; exit 2; }
  RANGE="$2"; shift 2
  REPO="${1:-$PWD}"
  git -C "$REPO" rev-parse --git-dir >/dev/null 2>&1 || { echo "FAIL: not a git repo: $REPO"; exit 1; }
  git -C "$REPO" rev-parse "$RANGE" >/dev/null 2>&1 || { echo "FAIL: bad git range: $RANGE"; exit 1; }
  TMP=$(mktemp -d) || { echo "FAIL: cannot create temp dir"; exit 1; }
  trap 'rm -rf "$TMP"' EXIT
  n=0
  # Every commit, every file it touched, at that commit's version. Deleted paths are
  # skipped by the `git show` failure, which is correct -- a deletion adds no secret.
  while read -r sha; do
    [ -n "$sha" ] || continue
    while read -r f; do
      [ -n "$f" ] || continue
      # NOT an extension allowlist. Most scripts in this repo have no extension at all
      # (mhl-pr, mhl-no-secrets, pre-push, Makefile), and an allowlist silently skipped
      # four of the five files in the very commit that introduced this mode. Mirror the
      # directory scan instead: take everything, drop the same paths it excludes, and
      # drop binaries after the fact with grep -I.
      case "$f" in
        .git/*|*/.git/*|.venv/*|*/.venv/*|*/collections/*|collections/*|archive/*|*/archive/*|research/*|*/research/*|.ansible/*|*/.ansible/*) continue ;;
      esac
      out="$TMP/${sha:0:8}/$f"
      mkdir -p "$(dirname "$out")" 2>/dev/null || continue
      git -C "$REPO" show "$sha:$f" > "$out" 2>/dev/null || { rm -f "$out"; continue; }
      grep -qI . "$out" 2>/dev/null || { rm -f "$out"; continue; }   # binary: nothing to read
      n=$((n+1))
    done < <(git -C "$REPO" diff-tree --no-commit-id --name-only -r "$sha" 2>/dev/null)
  done < <(git -C "$REPO" rev-list "$RANGE" 2>/dev/null)
  echo "no-secrets: range $RANGE — $n file version(s) across $(git -C "$REPO" rev-list --count "$RANGE" 2>/dev/null) commit(s)"
  [ "$n" -eq 0 ] && { echo "no-secrets: PASS (range touched no scannable files)"; exit 0; }
  set -- "$TMP"
fi

DIRS=("$@"); [ ${#DIRS[@]} -eq 0 ] && DIRS=("$HERE" "$HERE/../McHomeLab-Inventory")
for d in "${DIRS[@]}"; do case "$d" in -*) echo "usage: mhl-no-secrets [--range <git-range>] [dir ...]"; exit 2 ;; esac; [ -d "$d" ] || { echo "FAIL: no such directory: $d"; exit 1; }; done
SHAPE_RE='(?<![A-Za-z0-9+/])[A-Za-z0-9+/]{43}=(?![A-Za-z0-9+/=])|gh[pousr]_[A-Za-z0-9]{36,}|claim-[A-Za-z0-9_-]{15,}|-----BEGIN [A-Z ]*PRIVATE KEY-----'
EXCL=(--exclude-dir=.git --exclude-dir=.venv --exclude-dir=collections --exclude-dir=archive --exclude-dir=research --exclude-dir=.ansible)
PY="$HERE/.venv/bin/python3"; MOD="$HERE/scripts/mhl_secrets.py"
rc=0
for d in "${DIRS[@]}"; do
  [ -d "$d" ] || continue
  pv=$(find "$d" -type f -name '*.pre-vault' -not -path '*/.git/*' 2>/dev/null); [ -n "$pv" ] && { echo "FAIL: plaintext pre-vault backup inside the tree (belongs in ~/.mhl/pre-vault):"; echo "$pv"; rc=1; }
done
name_pass() { # $1 = dir
  local d="$1" files
  files=$(find "$d" -type f \( -name '*.yml' -o -name '*.yaml' -o -name '*.pre-vault' \) \
          -not -path '*/.git/*' -not -path '*/.venv/*' -not -path '*/collections/*' -not -path '*/archive/*' -not -path '*/research/*' -not -path '*/.ansible/*' -not -path '*inventory/test.yml' 2>/dev/null)
  [ -z "$files" ] && return 0
  # FAIL CLOSED: the node model is the authority for YAML; if it cannot run
  # (no venv python, module missing/unreadable/broken), the pass fails with a
  # message — never silently, never by quietly weakening to the line regex.
  [ -x "$PY" ] || { echo "$d: cannot run the name pass — $PY missing (poetry install)"; return 2; }
  [ -r "$MOD" ] || { echo "$d: cannot run the name pass — $MOD missing or unreadable"; return 2; }
  "$PY" -c "import importlib.util,sys; s=importlib.util.spec_from_file_location('m', sys.argv[1]); m=importlib.util.module_from_spec(s); s.loader.exec_module(m); assert callable(m.gate_findings) and m.SECRET_WORDS" "$MOD" >/dev/null 2>&1 \
    || { echo "$d: cannot run the name pass — $MOD failed to import or lacks gate_findings/SECRET_WORDS"; return 2; }
  local lst; lst=$(mktemp) || return 2
  printf '%s\n' "$files" > "$lst"
  "$PY" - "$MOD" "$lst" <<'PYEOF'
import importlib.util, sys
spec = importlib.util.spec_from_file_location("mhl_secrets", sys.argv[1]); m = importlib.util.module_from_spec(spec); spec.loader.exec_module(m)
bad = 0
for path in open(sys.argv[2], encoding="utf-8").read().split("\n"):
    if not path: continue
    try: text = open(path, encoding="utf-8").read()
    except (OSError, UnicodeDecodeError): print(f"{path}: unreadable or not UTF-8"); bad += 1; continue
    finds, note = m.gate_findings(text)
    if note: print(f"{path}: {note}")
    lines = text.split("\n")
    for f in finds:
        # `# no-secret: <why>` on the finding's own line waives it (the module already
        # honours the marker on a block scalar's key line for `embedded`).
        if 0 < f.line <= len(lines) and "no-secret:" in lines[f.line - 1]: continue
        print(f"{path}:{f.line}: {f.key}: <redacted> [{f.cls}]"); bad += 1
sys.exit(1 if bad else 0)
PYEOF
  local prc=$?; rm -f "$lst"; return $prc
}
for d in "${DIRS[@]}"; do
  [ -d "$d" ] || continue
  hits=$(name_pass "$d"); nrc=$?
  if [ "$nrc" -eq 2 ]; then echo "FAIL: $hits"; rc=1
  elif [ -n "$hits" ]; then echo "FAIL: name-shaped plaintext secret value(s):"; echo "$hits"; rc=1
  elif [ "$nrc" -ne 0 ]; then echo "FAIL: name pass errored in $d (module raised)"; rc=1; fi
  hits=$(grep -rnP "${EXCL[@]}" --exclude='mhl-no-secrets' "$SHAPE_RE" "$d" 2>/dev/null \
         | grep -v 'no-secret:' | cut -d: -f1,2 | sed 's/$/: <redacted value-shaped secret>/' || true)
  [ -n "$hits" ] && { echo "FAIL: value-shaped secret(s):"; echo "$hits"; rc=1; }
done
[ $rc -eq 0 ] && echo "no-secrets: PASS"
exit $rc
