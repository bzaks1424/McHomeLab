#!/usr/bin/env python3
"""Vault every plaintext secret value in a YAML file, in place, as inline !vault.

Line-oriented on purpose: it preserves comments, ordering and formatting that a
YAML round-trip would not. A line is a secret when its key ends in a secret
word (same rule as scripts/mhl-no-secrets) and its value is a plain/quoted
scalar (not already !vault, not a {{ }} reference, not empty).

Usage: mhl-vault-file <file> [--dry-run]
Requires ansible-vault + vault_identity_list configured (ansible/ansible.cfg).
"""
import os, re, subprocess, sys

SECRET = re.compile(
    r'^(?P<indent>[ \t]*(?:- )?)(?P<key>(?:[A-Za-z0-9._]*_)?(?i:pass|password|passwd|secret|token|api_?key|apikey|claim|private_key|preshared_key|credential))'
    r'[ \t]*:[ \t]*(?P<val>"[^"]*"|\'[^\']*\'|[^#\s][^#]*?)[ \t]*(?P<comment>#.*)?$')

def encrypt(name, value):
    out = subprocess.run(
        ["ansible-vault", "encrypt_string", "--encrypt-vault-id", "mhl", "--name", name, value],
        capture_output=True, text=True, check=True,
        cwd=os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "ansible"),
    ).stdout
    lines = [l for l in out.splitlines() if l.strip()]
    assert lines[0].startswith(f"{name}: !vault |"), lines[0]
    return [l.strip() for l in lines[1:]]

def main():
    path = sys.argv[1]; dry = "--dry-run" in sys.argv
    src = open(path).read().splitlines()
    out, n = [], 0
    for line in src:
        m = SECRET.match(line)
        if not m or m.group("val").startswith(("!vault", "{{", '"{{', "'{{")):
            out.append(line); continue
        val = m.group("val")
        if val[0] in "\"'" and val[-1] == val[0]:
            val = val[1:-1]
        n += 1
        if dry:
            out.append(line); print(f"would vault: {m.group('key')}"); continue
        indent = m.group("indent"); body_indent = " " * (len(indent.replace("- ", "  ")) + 2)
        out.append(f"{indent}{m.group('key')}: !vault |" + (f"  {m.group('comment')}" if m.group("comment") else ""))
        out.extend(body_indent + l for l in encrypt(m.group("key"), val))
    if not dry:
        open(path, "w").write("\n".join(out) + "\n")
    print(f"{'would vault' if dry else 'vaulted'} {n} value(s) in {path}")

if __name__ == "__main__":
    main()
