#!/usr/bin/env python3
"""Vault every plaintext secret value in a YAML file, in place, as inline !vault.

Line-oriented on purpose: it preserves comments, ordering and formatting that a
YAML round-trip would not. A line is a secret when its key ends in a secret
word (the SAME regex as scripts/mhl-no-secrets, imported from it) and its
value is a scalar that is not already !vault, not a {{ }} reference, and not
empty.

Safety properties (reviews of PR #6, 2026-08-25):
- The value is taken from the SOURCE TEXT via a YAML scanner that never
  resolves types (BaseLoader), so `004821` stays `004821`, `yes` stays `yes`.
  Never a hand regex, never PyYAML's implicit resolver.
- Any YAML error is reported as "could not parse line N" — the exception text
  (which quotes the source line) is never printed.
- The value goes to ansible-vault on STDIN (--stdin-name), never argv.
- Block/folded scalars, flow collections, aliases/anchors, multi-document
  files and symlinked targets are refused before anything is written.
- Every produced block is decrypted and compared byte-for-byte to the source
  value; the whole output is then re-scanned and every vaulted key is decrypted
  again from the new file before it replaces the original.
- Output is written to a temp file in the target's directory (0600, mode of
  the original restored) and renamed over it; temp files are removed on every
  failure path. The original is preserved OUTSIDE the repo at
  ~/.mhl/pre-vault/<name>.<timestamp> created O_EXCL 0600 — never next to the
  file, never at a path the gate ignores. Nothing is ever clobbered.
- ansible-vault and python come from the project venv, not PATH.

Lifecycle of the plaintext original (Mike's requirement, 2026-08-25):
  1. Durable home = Mike's password safe (the same escrow as the vault
     password). Never a repo. The vaulted value in the inventory is the git
     artifact.
  2. ~/.mhl/pre-vault/<name>.<ts>.<pid> is RETAINED until verified:
     `mhl-vault-file --purge <inventory.yml ...>` reads each backup's
     plaintext values, decrypts the same keys from the given committed files,
     and compares BYTE FOR BYTE; a backup is shredded only when every one of
     its keys matches. Missing key, mismatch, decrypt failure, unknown source
     file: refuse and name the key/file, never the value. Retention is tied
     to verified fidelity, not to "it decrypts" and not to time.
  3. `mhl-vault-file --list` shows pending backups; session_context reports
     the pending count at every session start.
  4. mhl-no-secrets fails on any *.pre-vault inside a tree; this tool refuses
     to run if ~/.mhl/pre-vault is group/world accessible.

Usage: mhl-vault-file <file> [--dry-run] | --list | --purge <inventory.yml ...>
"""
import io
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
ANSIBLE_DIR = os.path.join(ROOT, "ansible")
VENV_PY = os.path.join(ROOT, ".venv", "bin", "python3")
VAULT = os.path.join(ROOT, ".venv", "bin", "ansible-vault")
VAULT_ID = "mhl"
BACKUP_DIR = os.path.join(os.path.expanduser("~"), ".mhl", "pre-vault")

# Re-exec under the venv so PyYAML is the pinned one (same argument as ansible-vault).
if os.path.realpath(sys.executable) != os.path.realpath(VENV_PY) and os.access(VENV_PY, os.X_OK) and not os.environ.get("MHL_VAULT_FILE_REEXEC"):
    os.environ["MHL_VAULT_FILE_REEXEC"] = "1"
    os.execv(VENV_PY, [VENV_PY, os.path.abspath(__file__), *sys.argv[1:]])

import yaml  # noqa: E402


def die(msg):
    print(f"mhl-vault-file: {msg}", file=sys.stderr)
    sys.exit(1)


def secret_key_regex():
    """The single source of truth for 'what is a secret key' is mhl-no-secrets."""
    src = open(os.path.join(ROOT, "scripts", "mhl-no-secrets"), encoding="utf-8").read()
    m = re.search(r"^NAME_RE='(.*)'$", src, re.M)
    if not m:
        die("cannot find NAME_RE in scripts/mhl-no-secrets")
    words = re.search(r"\(\?i:([^)]*)\)", m.group(1)).group(1)
    return re.compile(
        r"^(?P<indent>[ \t]*(?:-[ \t]*)*)"
        r"(?P<key>(?:[A-Za-z0-9._]*_)?(?i:" + words + r"))"
        r"[ \t]*:(?P<rest>.*)$"
    )


def run_vault(args, stdin):
    r = subprocess.run([VAULT, *args], input=stdin, capture_output=True, text=True, cwd=ANSIBLE_DIR)
    if r.returncode:
        tail = r.stderr.strip().splitlines()[-1] if r.stderr.strip() else "no stderr"
        die(f"ansible-vault {args[0]} failed: {tail}")  # stderr from ansible-vault never contains the stdin value
    return r.stdout


def encrypt(name, value):
    out = run_vault(["encrypt_string", "--encrypt-vault-id", VAULT_ID, "--stdin-name", name], value)
    lines = [l for l in out.splitlines() if l.strip()]
    if not lines or not lines[0].startswith(f"{name}: !vault |"):
        die(f"unexpected encrypt_string output shape for {name}")
    body = [l.strip() for l in lines[1:]]
    if run_vault(["decrypt", "--output", "-"], "\n".join(body)) != value:
        die(f"round-trip mismatch for {name}; nothing written")
    return body


def raw_scalar(rest, key, lineno):
    """Return (raw_value_text, trailing_comment) from source text, or None.

    Uses the YAML *scanner* with BaseLoader semantics (no type resolution):
    the scalar's text is taken from the token, exactly as written, unquoted
    and unescaped by the YAML rules only.
    """
    stripped = rest.strip()
    if stripped == "" or stripped.startswith("#"):
        return None
    if stripped.startswith(("!vault", "{{", '"{{', "'{{")):
        return None
    if stripped[0] in "|>":
        die(f"line {lineno}: {key} is a block scalar; vault it by hand with "
            f"`ansible-vault encrypt_string --encrypt-vault-id {VAULT_ID} --stdin-name {key} < value-file`")
    if stripped[0] in "[{":
        die(f"line {lineno}: {key} is a flow collection, not a scalar secret")
    if stripped[0] in "*&":
        die(f"line {lineno}: {key} uses a YAML alias/anchor; not supported")
    try:
        tokens = list(yaml.scan(io.StringIO(rest), Loader=yaml.BaseLoader))
    except yaml.YAMLError:
        die(f"line {lineno}: could not parse a scalar value for {key}")
    scalars = [t for t in tokens if isinstance(t, yaml.ScalarToken)]
    if len(scalars) != 1:
        die(f"line {lineno}: could not parse a single scalar value for {key}")
    tok = scalars[0]
    value = tok.value
    # trailing comment = text after the scalar token's end, if it starts with '#'
    tail = rest[tok.end_mark.index:].strip()
    comment = tail if tail.startswith("#") else ""
    if tail and not comment:
        die(f"line {lineno}: unexpected trailing text after the value of {key}")
    return value, comment


def read_text(path):
    try:
        with open(path, "rb") as f:
            data = f.read()
    except OSError as e:
        die(f"cannot read {path}: {e.strerror}")
    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError:
        die(f"{path} is not UTF-8; refusing")
    if "\r\n" in text:
        die(f"{path} has CRLF line endings; normalise it first (refusing to rewrite line endings silently)")
    if re.search(r"^---\s*$", text, re.M) and text.count("\n---") > 0:
        # a leading '---' is fine; a second document marker is not
        if len(re.findall(r"^---\s*$", text, re.M)) > 1:
            die(f"{path} is a multi-document YAML file; not supported")
    return text


def vault_blocks(text):
    """Yield (key, ciphertext_body) for every inline !vault block in text."""
    lines = text.split("\n"); i = 0
    while i < len(lines):
        bm = re.match(r"^(\s*(?:-\s*)*)([A-Za-z0-9_.]+): !vault \|", lines[i])
        if bm:
            ind = len(bm.group(1)); body = []; j = i + 1
            while j < len(lines) and lines[j].strip() and len(lines[j]) - len(lines[j].lstrip()) > ind:
                body.append(lines[j].strip()); j += 1
            yield bm.group(2), "\n".join(body); i = j
        else:
            i += 1


def backups():
    if not os.path.isdir(BACKUP_DIR):
        return []
    mode = os.stat(BACKUP_DIR).st_mode & 0o077
    if mode:
        die(f"{BACKUP_DIR} is group/world accessible (mode {oct(os.stat(BACKUP_DIR).st_mode & 0o777)}); fix with chmod 700")
    return sorted(os.path.join(BACKUP_DIR, f) for f in os.listdir(BACKUP_DIR))


def cmd_list():
    bs = backups()
    if not bs:
        print("no pending pre-vault backups"); return
    now = time.time()
    for b in bs:
        st = os.stat(b)
        print(f"{b}  {int((now - st.st_mtime) // 3600)}h old  mode {oct(st.st_mode & 0o777)}")
    print(f"{len(bs)} pending — lifecycle: escrow the plaintext in Mike's password safe, then `mhl-vault-file --purge` once the vaulted values are verified")


def cmd_purge(inventory_files):
    """Shred a backup only when EVERY plaintext secret it holds compares
    byte-for-byte with the decrypted !vault value for the same key in the
    given committed inventory file. "It decrypts" is not enough — that proves
    the password, not fidelity. Every ambiguous case refuses. Values are never
    printed; only key names and paths."""
    bs = backups()
    if not bs:
        print("no pending pre-vault backups"); return
    if not inventory_files:
        die("--purge needs the committed inventory file(s) to compare against, e.g. --purge ../McHomeLab-Inventory/hosts.yml")
    inv_by_name = {}
    for f in inventory_files:
        if not os.path.isfile(f):
            die(f"no such inventory file: {f}")
        inv_by_name.setdefault(os.path.basename(f), []).append(f)
    key_re = secret_key_regex()
    verified, shredded = 0, 0
    for b in bs:
        base = os.path.basename(b)
        m = re.match(r"^(?P<name>.+)\.\d{8}T\d{6}\.\d+$", base)
        if not m or m.group("name") not in inv_by_name:
            die(f"{b}: no inventory file named '{m.group('name') if m else base}' was given — refusing (pass the matching committed file)")
        # decrypted values from the committed inventory, per key (a key may repeat)
        inv_vals = {}
        for f in inv_by_name[m.group("name")]:
            for key, body in vault_blocks(read_text(f)):
                r = subprocess.run([VAULT, "decrypt", "--output", "-"], input=body, capture_output=True, text=True, cwd=ANSIBLE_DIR)
                if r.returncode:
                    die(f"{f}: {key} does not decrypt under the current vault password — refusing (rotated password? re-vault first)")
                inv_vals.setdefault(key, []).append(r.stdout)
        # plaintext originals from the backup
        expected = []
        for lineno, line in enumerate(read_text(b).split("\n"), 1):
            km = key_re.match(line)
            if not km:
                continue
            parsed = raw_scalar(km.group("rest"), km.group("key"), lineno)
            if parsed is None:
                continue
            expected.append((km.group("key"), parsed[0]))
        if not expected:
            die(f"{b}: contains no plaintext secret values — refusing (nothing to compare; inspect it by hand)")
        for key, plain in expected:
            cands = inv_vals.get(key)
            if not cands:
                die(f"{b}: key '{key}' has no !vault value in the inventory — refusing")
            if not any(hmac_eq(plain, c) for c in cands):
                die(f"{b}: key '{key}' does NOT match the decrypted inventory value — refusing; the inventory may hold a corrupted secret")
            verified += 1
    # Two-phase: every backup verified above; only now shred (no partial purge).
    for b in bs:
        size = os.path.getsize(b)
        with open(b, "r+b") as fh:
            fh.write(os.urandom(size)); fh.flush(); os.fsync(fh.fileno())
        os.unlink(b); shredded += 1
    print(f"verified {verified} value(s) byte-for-byte against the inventory; shredded {shredded} backup(s)")


def hmac_eq(a, b):
    import hmac
    return hmac.compare_digest(a.encode("utf-8"), b.encode("utf-8"))


def main():
    args = sys.argv[1:]
    if args and args[0] == "--list":
        cmd_list(); return
    if args and args[0] == "--purge":
        cmd_purge(args[1:]); return
    dry = "--dry-run" in args
    if dry:
        args.remove("--dry-run")
    if len(args) != 1 or args[0].startswith("-"):
        die("usage: mhl-vault-file <file> [--dry-run] | --list | --purge <inventory.yml ...>")
    path = args[0]
    if os.path.isdir(path):
        die(f"{path} is a directory")
    if os.path.islink(path):
        die(f"{path} is a symlink; run on the real file ({os.path.realpath(path)})")
    if not os.path.isfile(path):
        die(f"no such file: {path}")
    if not dry and not os.access(VAULT, os.X_OK):
        die(f"{VAULT} not found — run `make deps` / poetry install first")

    key_re = secret_key_regex()
    text = read_text(path)
    src = text.split("\n")
    if src and src[-1] == "":
        src.pop()
    out, todo = [], []
    for lineno, line in enumerate(src, 1):
        m = key_re.match(line)
        if not m:
            out.append(line); continue
        parsed = raw_scalar(m.group("rest"), m.group("key"), lineno)
        if parsed is None:
            out.append(line); continue
        value, comment = parsed
        if dry:
            print(f"would vault: {m.group('key')} (line {lineno})"); out.append(line); continue
        indent = m.group("indent")
        body_indent = " " * (len(indent.replace("-", " ")) + 2)
        out.append(f"{indent}{m.group('key')}: !vault |" + (f"  {comment}" if comment else ""))
        out.extend(body_indent + l for l in encrypt(m.group("key"), value))
        todo.append((m.group("key"), value))

    if dry:
        print(f"dry run complete for {path}")
        return
    if not todo:
        print(f"nothing to vault in {path}"); return

    new_text = "\n".join(out) + "\n"
    # Second, independent verification: scan the NEW text, decrypt every vaulted
    # key, and compare with what we intended to store.
    blocks, i = {}, 0
    lines = new_text.split("\n")
    while i < len(lines):
        bm = re.match(r"^(\s*(?:-\s*)*)([A-Za-z0-9_.]+): !vault \|", lines[i])
        if bm:
            ind = len(bm.group(1)); body = []; j = i + 1
            while j < len(lines) and lines[j].strip() and len(lines[j]) - len(lines[j].lstrip()) > ind:
                body.append(lines[j].strip()); j += 1
            blocks.setdefault(bm.group(2), []).append("\n".join(body)); i = j
        else:
            i += 1
    for key, value in todo:
        cands = blocks.get(key, [])
        if not any(run_vault(["decrypt", "--output", "-"], b) == value for b in cands):
            die(f"post-write verification failed for {key}; nothing written")

    # Backup OUTSIDE the repo, O_EXCL 0600, never clobbered.
    os.makedirs(BACKUP_DIR, mode=0o700, exist_ok=True)
    os.chmod(BACKUP_DIR, 0o700)
    backup = os.path.join(BACKUP_DIR, f"{os.path.basename(path)}.{time.strftime('%Y%m%dT%H%M%S')}.{os.getpid()}")
    try:
        fd = os.open(backup, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    except FileExistsError:
        die(f"backup path already exists: {backup}")
    with os.fdopen(fd, "wb") as f:
        f.write(text.encode("utf-8"))

    orig_mode = os.stat(path).st_mode & 0o777
    fd, tmp = tempfile.mkstemp(prefix=".mhl-vault-", dir=os.path.dirname(os.path.abspath(path)))
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(new_text)
        os.chmod(tmp, orig_mode)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
    print(f"vaulted {len(todo)} value(s) in {path}; plaintext original preserved at {backup} (0600, outside any repo).\n"
          f"Lifecycle: escrow the plaintext in the password safe; once the vaulted values are verified, run "
          f"`mhl-vault-file --purge {path}` (decrypts every value first, then shreds). `--list` shows pending backups.")


if __name__ == "__main__":
    main()
